#!/bin/sh
# O remove guarda a configuração, o token e o HWID: instalado de novo, o agente
# volta como a mesma máquina. O purge apaga /etc/sentinel-agent e
# /var/lib/sentinel-agent (A19, A20).
set -e

if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
	systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
	deb-systemd-helper mask sentinel-agent.service >/dev/null || true
fi

if [ "$1" = purge ]; then
	if [ -x /usr/bin/deb-systemd-helper ]; then
		deb-systemd-helper purge sentinel-agent.service >/dev/null || true
		deb-systemd-helper unmask sentinel-agent.service >/dev/null || true
	fi
	rm -rf /etc/sentinel-agent /var/lib/sentinel-agent
fi
