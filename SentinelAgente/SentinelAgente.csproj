<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- O nome do binário instalado, o mesmo do serviço e do ExecStart da unidade (packaging/sentinel-agent.service) -->
    <AssemblyName>sentinel-agent</AssemblyName>
    <RootNamespace>SentinelAgente</RootNamespace>
    <!-- A versão do pacote .deb e a AgentVersion do handshake (A25) -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SentinelAgente.Tests" />
  </ItemGroup>

</Project>
